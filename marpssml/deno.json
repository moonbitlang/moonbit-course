    "@std/cli": "jsr:@std/cli@^1.0.20",
    "@std/crypto": "jsr:@std/crypto@^1.0.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.5",
    "azure-tts": "npm:microsoft-cognitiveservices-speech-sdk@^1.45.0"
  },
  "tasks": {
